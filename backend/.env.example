# ==============================================================================
# RicozInfra Backend Pipeline — Production Environment Configuration
# ==============================================================================

# Server Network & Host
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Ingestion Rate Limiter (requests per minute per IP for collector daemons)
RATE_LIMIT_MAX=50000
RATE_LIMIT_TIME_WINDOW=1 minute

# Redis Streams (In-Memory Decoupling Buffer)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_KEY=stream:telemetry:raw
REDIS_CONSUMER_GROUP=group:telemetry:processors
REDIS_STREAM_MAXLEN=500000

# ClickHouse Time-Series Columnar Store
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DATABASE=ricozinfra_telemetry
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_BATCH_SIZE=2000
CLICKHOUSE_FLUSH_INTERVAL_MS=500

# PostgreSQL (Host Metadata & Alert Rules Engine)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ricozinfra_metadata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_MAX=20
POSTGRES_IDLE_TIMEOUT_MILLIS=30000

# WebSocket Live Telemetry Dispatcher
WS_HEARTBEAT_INTERVAL_MS=15000
WS_BROADCAST_INTERVAL_MS=1000

# Host Collector Daemon Target Endpoint
INGESTION_GATEWAY_URL=http://localhost:8080/api/v1/telemetry/ingest
COLLECTOR_HOST_ID=c73e34b2-2980-4c31-90c7-123456789abc
COLLECTOR_HOSTNAME=prod-edge-gw-01
COLLECTOR_CLUSTER=us-east-cluster-01
COLLECTOR_ROLE=Edge-Gateway
COLLECTOR_INTERVAL_MS=1000
